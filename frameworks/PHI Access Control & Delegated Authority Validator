PHI Access Control Module (§ 164.312(a)(1) & § 164.308(a)(4))
------------------------------------------------------------
Implements Role-Based (RBAC) and Attribute-Based Access Control (ABAC) with runtime
delegated authority validation for autonomous healthcare AI agents.

Core Design Principle: An agent's assigned objective must never be treated as 
unlimited authorization to pursue that objective.

HIPAA Safeguard Mapping:
- 45 CFR § 164.312(a)(1): Access Control (Unique User ID & Role Isolation)
- 45 CFR § 164.308(a)(4): Information Access Management (Minimum Necessary)
- 45 CFR § 164.502(e): Business Associate Agreement (BAA) Runtime Requirement
"""

import logging
from datetime import datetime
from enum import Enum
from typing import Any, Dict, List, Optional, Set
from dataclasses import dataclass, field

# Configure structured module logger
logger = logging.getLogger("HIPAA-Controls.AccessControl")
logger.addHandler(logging.NullHandler())


# ============================================================================
# EXCEPTIONS
# ============================================================================

class AccessControlException(Exception):
    """Base exception for access control validation failures."""
    pass


class BAAViolationError(AccessControlException):
    """Raised when an operation is attempted without a verified active BAA."""
    pass


class ScopeExceededError(AccessControlException):
    """Raised when an agent attempts to access a patient or resource outside scope."""
    pass


class HumanApprovalRequiredError(AccessControlException):
    """Raised when a high-impact operation is attempted without HITL token."""
    pass


# ============================================================================
# DATA STRUCTURES & ENUMS
# ============================================================================

class AccessLevel(Enum):
    """Defines permitted operational access levels on ePHI resources."""
    READ = "READ"           # Query or view existing ePHI
    DRAFT = "DRAFT"         # Prepare un-finalized notes or draft responses
    WRITE = "WRITE"         # Direct modification of patient records or database
    TRANSMIT = "TRANSMIT"   # External API invocation, email, or data exfiltration
    ADMIN = "ADMIN"         # System-level policy or configuration management


class ComplianceStatus(Enum):
    AUTHORIZED = "AUTHORIZED"
    DENIED_IDENTITY_MISMATCH = "DENIED_IDENTITY_MISMATCH"
    DENIED_BAA_MISSING = "DENIED_BAA_MISSING"
    DENIED_NO_DELEGATOR = "DENIED_NO_DELEGATOR"
    DENIED_PATIENT_SCOPE = "DENIED_PATIENT_SCOPE"
    DENIED_ACTION_NOT_PERMITTED = "DENIED_ACTION_NOT_PERMITTED"
    DENIED_HUMAN_APPROVAL_REQUIRED = "DENIED_HUMAN_APPROVAL_REQUIRED"


@dataclass
class AgentContext:
    """
    Represents the runtime security profile of an autonomous AI agent.
    """
    agent_id: str
    delegating_user_id: str
    assigned_role: str
    approved_patient_ids: Set[str] = field(default_factory=set)
    permitted_actions: Set[AccessLevel] = field(default_factory=set)
    permitted_tools: Set[str] = field(default_factory=set)
    has_active_baa: bool = False
    session_metadata: Dict[str, Any] = field(default_factory=dict)

    def validate_schema(self) -> None:
        """Validates that essential fields are populated on context instantiation."""
        if not self.agent_id or not isinstance(self.agent_id, str):
            raise ValueError("AgentContext requires a valid string 'agent_id'.")
        if not self.delegating_user_id:
            raise ValueError("AgentContext requires a valid 'delegating_user_id'.")


@dataclass
class ActionRequest:
    """
    Represents a proposed operation generated by an AI agent reasoning loop.
    """
    agent_id: str
    target_patient_id: str
    requested_action: AccessLevel
    tool_name: str
    request_context: Dict[str, Any] = field(default_factory=dict)
    human_approval_token: Optional[str] = None


@dataclass
class ValidationResult:
    """
    Audit-ready result object produced by the PHIAccessValidator.
    """
    is_permitted: bool
    status_code: ComplianceStatus
    reason: str
    agent_id: str
    target_patient_id: str
    tool_name: str
    timestamp: str = field(default_factory=lambda: datetime.utcnow().isoformat() + "Z")
    audit_payload: Dict[str, Any] = field(default_factory=dict)

    def to_dict(self) -> Dict[str, Any]:
        """Converts result into a standard JSON-serializable dictionary for audit logging."""
        return {
            "timestamp": self.timestamp,
            "is_permitted": self.is_permitted,
            "status_code": self.status_code.value,
            "reason": self.reason,
            "agent_id": self.agent_id,
            "target_patient_id": self.target_patient_id,
            "tool_name": self.tool_name,
            "audit_payload": self.audit_payload
        }


# ============================================================================
# CORE VALIDATOR ENGINE
# ============================================================================

class PHIAccessValidator:
    """
    5-Point Runtime Authorization & Least Privilege Validator.
    Evaluates every tool call and data access attempt before execution.
    """

    DEFAULT_HIGH_IMPACT_TOOLS = {
        "finalize_clinical_note",
        "modify_medication_order",
        "transmit_external_phi",
        "delete_patient_record",
        "issue_pharmacy_prescription"
    }

    def __init__(
        self, 
        high_impact_tools: Optional[Set[str]] = None,
        strict_fail_closed: bool = True
    ):
        """
        Initialize the validator.
        :param high_impact_tools: Set of tool names requiring explicit HITL tokens.
        :param strict_fail_closed: If True, any unexpected error results in authorization rejection.
        """
        self.high_impact_tools = high_impact_tools or self.DEFAULT_HIGH_IMPACT_TOOLS
        self.strict_fail_closed = strict_fail_closed

    def validate_action(self, agent: AgentContext, request: ActionRequest) -> ValidationResult:
        """
        Executes the 5-Point Runtime Check against a proposed action request.
        """
        try:
            # Schema Integrity Sanity Check
            agent.validate_schema()

            # ----------------------------------------------------------------
            # CHECK 1: Identity & Active BAA Status
            # ----------------------------------------------------------------
            if agent.agent_id != request.agent_id:
                return self._build_result(
                    is_permitted=False,
                    status=ComplianceStatus.DENIED_IDENTITY_MISMATCH,
                    reason=f"Identity Mismatch: Request agent ID '{request.agent_id}' does not match context agent ID '{agent.agent_id}'.",
                    agent=agent,
                    request=request
                )

            if not agent.has_active_baa:
                return self._build_result(
                    is_permitted=False,
                    status=ComplianceStatus.DENIED_BAA_MISSING,
                    reason="Runtime Execution Halted: Active Business Associate Agreement (BAA) verification token is missing or expired.",
                    agent=agent,
                    request=request
                )

            # ----------------------------------------------------------------
            # CHECK 2: Attributable Delegating Authority
            # ----------------------------------------------------------------
            if not agent.delegating_user_id or len(agent.delegating_user_id.strip()) == 0:
                return self._build_result(
                    is_permitted=False,
                    status=ComplianceStatus.DENIED_NO_DELEGATOR,
                    reason="Unattributable Agent: No active delegating human operator or supervisor ID found in execution context.",
                    agent=agent,
                    request=request
                )

            # ----------------------------------------------------------------
            # CHECK 3: Patient Scope Alignment (ABAC / Minimum Necessary)
            # ----------------------------------------------------------------
            if request.target_patient_id not in agent.approved_patient_ids:
                return self._build_result(
                    is_permitted=False,
                    status=ComplianceStatus.DENIED_PATIENT_SCOPE,
                    reason=f"Patient Scope Exceeded: Agent '{agent.agent_id}' is not authorized to access record for patient '{request.target_patient_id}'.",
                    agent=agent,
                    request=request
                )

            # ----------------------------------------------------------------
            # CHECK 4: Action Level & Tool Permission (RBAC)
            # ----------------------------------------------------------------
            if request.requested_action not in agent.permitted_actions:
                return self._build_result(
                    is_permitted=False,
                    status=ComplianceStatus.DENIED_ACTION_NOT_PERMITTED,
                    reason=f"Action Level Denied: '{request.requested_action.value}' is not granted to role '{agent.assigned_role}'.",
                    agent=agent,
                    request=request
                )

            if agent.permitted_tools and request.tool_name not in agent.permitted_tools:
                return self._build_result(
                    is_permitted=False,
                    status=ComplianceStatus.DENIED_ACTION_NOT_PERMITTED,
                    reason=f"Tool Access Denied: Tool '{request.tool_name}' is not present in permitted tool list for agent '{agent.agent_id}'.",
                    agent=agent,
                    request=request
                )

            # ----------------------------------------------------------------
            # CHECK 5: High-Impact Human Oversight Gate (HITL)
            # ----------------------------------------------------------------
            if request.tool_name in self.high_impact_tools:
                if not request.human_approval_token:
                    return self._build_result(
                        is_permitted=False,
                        status=ComplianceStatus.DENIED_HUMAN_APPROVAL_REQUIRED,
                        reason=f"Human Gate Enforcement: High-impact tool '{request.tool_name}' requires an authorized human approval token.",
                        agent=agent,
                        request=request
                    )

            # All 5 Checks Passed
            return self._build_result(
                is_permitted=True,
                status=ComplianceStatus.AUTHORIZED,
                reason="Authorization Granted: Request satisfies role boundaries, patient scope, BAA status, and oversight rules.",
                agent=agent,
                request=request
            )

        except Exception as err:
            logger.error(f"Error during access validation execution: {str(err)}", exc_info=True)
            if self.strict_fail_closed:
                return ValidationResult(
                    is_permitted=False,
                    status_code=ComplianceStatus.DENIED_ACTION_NOT_PERMITTED,
                    reason=f"Fail-Closed Exception: An unexpected internal error occurred: {str(err)}",
                    agent_id=request.agent_id,
                    target_patient_id=request.target_patient_id,
                    tool_name=request.tool_name
                )
            raise

    def _build_result(
        self,
        is_permitted: bool,
        status: ComplianceStatus,
        reason: str,
        agent: AgentContext,
        request: ActionRequest
    ) -> ValidationResult:
        """Helper method to assemble structured audit payloads."""
        audit_data = {
            "delegating_user_id": agent.delegating_user_id,
            "assigned_role": agent.assigned_role,
            "requested_action": request.requested_action.value,
            "has_baa": agent.has_active_baa,
            "has_human_token": bool(request.human_approval_token)
        }
        
        if not is_permitted:
            logger.warning(f"[ACCESS DENIED] Agent: {agent.agent_id} | Reason: {reason}")
        else:
            logger.info(f"[ACCESS GRANTED] Agent: {agent.agent_id} | Action: {request.requested_action.value} | Tool: {request.tool_name}")

        return ValidationResult(
            is_permitted=is_permitted,
            status_code=status,
            reason=reason,
            agent_id=agent.agent_id,
            target_patient_id=request.target_patient_id,
            tool_name=request.tool_name,
            audit_payload=audit_data
        )

